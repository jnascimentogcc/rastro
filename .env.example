# PostgreSQL (docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://rastro:rastro@localhost:5432/rastro

# GitHub App (phase 4) - see README, "GitHub App setup"
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.private-key.pem
# alternatively the PEM itself, newlines written as backslash-n: GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# LLM (phase 5). No default models on purpose: pick them by running the evaluation
# (python -m rastro_worker.evaluate fixtures/clinica-demo) with two or three candidates.
OPENAI_API_KEY=
LLM_MODEL=
LLM_MODEL_IMPACT=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
# Optional, USD per million tokens, so llm_calls get a cost estimate (unset = unknown cost)
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
EMBEDDING_PRICE_PER_MTOK=
