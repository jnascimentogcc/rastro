# Production settings for docker-compose.prod.yml. deploy/install.sh copies this to .env and
# generates the secrets that are empty. Never commit the real .env.

# Public hostname served by the shared Caddy.
RASTRO_DOMAIN=rastro.karpaai.com

# Generated by install.sh (never replaced once set).
POSTGRES_PASSWORD=
# Fernet key(s) for session excerpts at rest, comma separated, the first one encrypts.
# LOSING IT MAKES STORED EXCERPTS UNREADABLE: keep a copy outside the server.
EXCERPTS_ENCRYPTION_KEYS=

# Production GitHub App (a separate App from the development one).
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# The private key lives in ./secrets/github-app.private-key.pem (chmod 600, not in git).

# LLM
OPENAI_API_KEY=
LLM_MODEL=
LLM_MODEL_IMPACT=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
# Max tokens (input + output) per repository per calendar month; also set a limit in the OpenAI dashboard.
LLM_MONTHLY_TOKEN_BUDGET=2000000

IMPACT_THRESHOLD=0.7
IMPACT_COMMENT_LANGUAGE=en
IMPACT_MAX_CANDIDATES=10
